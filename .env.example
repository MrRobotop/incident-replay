# Copy to .env.local for local development. Keep real keys in your local file or deployment secrets.
INCIDENT_REPLAY_MODE=demo
SUBQ_API_KEY=

# Origin of the browser UI. Use the HTTPS origin for an authenticated deployment.
INCIDENT_REPLAY_ORIGIN=http://localhost:3000

# Per-process browser limits. Every provider attempt, including a retry, uses one slot in the daily budget.
INCIDENT_REPLAY_DAILY_ATTEMPTS=100
INCIDENT_REPLAY_MAX_IN_FLIGHT=2

# Private incident library. Leave empty to serve only training scenarios.
INCIDENT_REPLAY_IMPORT_DIR=
INCIDENT_REPLAY_ALLOW_IMPORTED_SUBQ=false
