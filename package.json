{
  "name": "incident-replay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "replay": "node src/cli/replay.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "dev": "node --import ./src/server/bootstrap.ts node_modules/next/dist/bin/next dev --hostname localhost",
    "build": "node --import ./src/server/bootstrap.ts node_modules/next/dist/bin/next build",
    "start": "node --import ./src/server/bootstrap.ts node_modules/next/dist/bin/next start --hostname localhost",
    "lint": "eslint .",
    "test:browser": "playwright test",
    "eval": "node eval/cli.ts",
    "import:incident": "node src/import/cli.ts"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  },
  "license": "Apache-2.0",
  "overrides": {
    "minimatch": "11.0.8"
  }
}
